# llama-cpp-rocm-tq environment configuration
# Copy this file to .env and adjust values for your environment.

# Docker image
IMAGE_REGISTRY=ghcr.io
IMAGE_NAME=mkadrlik/llama-cpp-rocm-tq
IMAGE_TAG=latest

# Model
MODEL_PATH=/path/to/your/model.gguf
MODEL_MOUNT=/model.gguf

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# ROCm GPU override (adjust for your GPU architecture)
# gfx1100 = RX 7900 series (RDNA3)
# gfx1030 = RX 6800/6900 series (RDNA2)
# gfx90a = MI200 series (CDNA2)
HSA_OVERRIDE_GFX_VERSION=11.0.0

# TurboQuant cache types
# Options: f16, q8_0, turbo4, turbo3, turbo2
# Recommended: turbo3 for best balance of speed/quality/VRAM
CACHE_TYPE_K=q8_0
CACHE_TYPE_V=turbo3

# GPU layers (-1 = all layers offloaded)
GPU_LAYERS=99

# Thread count (leave empty to auto-detect)
THREADS=

# Context size (default: model's native context length)
CONTEXT_SIZE=

# Additional llama-server arguments (optional)
EXTRA_ARGS=
